# Secrets
SPOTIFY_CLIENT_ID=
SPOTIFY_CLIENT_SECRET=

# Any setting in src/saambha/settings.py can be overridden as SAAMBHA_<NAME>, e.g.:
# SAAMBHA_HARNESS=pi                        # default: claude
# SAAMBHA_PI_MODEL=ollama/saambha-gemma4:e4b # default: anthropic/claude-haiku-5-5
# SAAMBHA_EFFORT=low                        # default: off (how hard the model thinks)
# SAAMBHA_SKILLS_DIR=~/projects/my-skills   # default: ~/saambha-skills
# SAAMBHA_HEAVY_GPU_MB=2000                 # default: 1500
