#!/usr/bin/env python3
"""Fake `claude -p`: replies "You said: <prompt>" in stream-json, as the real CLI would.

Logs each call to $SAAMBHA_FAKES_STATE/claude_calls.jsonl. $SAAMBHA_FAKES_STATE/claude_mode:
  "hang"         never answers
  "fail"         fails every time, as when not logged in
  "fail-resume"  when asked to --resume, fails as the real CLI does: an error result, then exit 1
"""
import json
import os
import sys
import time
from pathlib import Path

state = Path(os.environ["SAAMBHA_FAKES_STATE"])
args = sys.argv[1:]
mode_file = state / "claude_mode"
mode = mode_file.read_text().strip() if mode_file.exists() else ""

calls = state / "claude_calls.jsonl"
n = len(calls.read_text().splitlines()) if calls.exists() else 0
with calls.open("a") as f:
    f.write(json.dumps({"args": args, "cwd": os.getcwd()}) + "\n")

if mode == "hang":
    os.execvp("sleep", ["sleep", "300"])

resume = args[args.index("--resume") + 1] if "--resume" in args else None
if mode == "fail":
    print(json.dumps({"type": "result", "subtype": "error_during_execution", "is_error": True, "result": ""}))
    print("Not logged in. Please run /login", file=sys.stderr)
    sys.exit(1)
if resume and mode == "fail-resume":
    print(json.dumps({"type": "result", "subtype": "error_during_execution", "is_error": True, "result": "",
                      "session_id": resume}), flush=True)
    print(f"No conversation found with session ID: {resume}", file=sys.stderr)
    sys.exit(1)

prompt = args[args.index("-p") + 1]
reply = f"You said: {prompt}"
for event in (
    {"type": "system", "subtype": "init"},
    {"type": "assistant", "message": {"content": [
        {"type": "tool_use", "name": "Skill", "input": {"skill": "spotify"}}]}},
    {"type": "assistant", "message": {"content": [{"type": "text", "text": reply}]}},
    {"type": "result", "result": reply, "session_id": resume or f"sess-{n + 1}"},
):
    print(json.dumps(event), flush=True)
