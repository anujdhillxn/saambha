{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Saambha",
  "version": "0.1.0",
  "identifier": "dev.saambha.desktop",
  "build": {
    "frontendDist": "ui"
  },
  "app": {
    "withGlobalTauri": true,
    "windows": [
      {
        "label": "stage",
        "title": "Saambha",
        "url": "stage/index.html",
        "transparent": true,
        "decorations": false,
        "shadow": false,
        "skipTaskbar": true,
        "focus": false,
        "visible": false
      },
      {
        "label": "dot",
        "title": "Saambha",
        "url": "dot/index.html",
        "width": 72,
        "height": 72,
        "minWidth": 72,
        "minHeight": 72,
        "maxWidth": 72,
        "maxHeight": 72,
        "transparent": true,
        "decorations": false,
        "shadow": false,
        "skipTaskbar": true,
        "focus": false,
        "visible": false
      }
    ],
    "security": {
      "csp": "default-src 'self'; style-src 'self' 'unsafe-inline'"
    }
  },
  "bundle": {
    "active": false,
    "icon": [
      "icons/icon.png"
    ]
  }
}
